# 模型网关（必填）
# 正式环境：DeepSeek 官方 key + https://api.deepseek.com/v1
# 开发期：AxonHub 网关 group/deepseek-pool（见 RAY-655 决策记录）
WENDO_LLM_API_KEY=
WENDO_LLM_BASE_URL=https://api.deepseek.com/v1

# 业务代码只写 lite；这里是把 lite 映射到实际模型 ID 的配置层
# 官方 Lite：deepseek-flash（服务版本 DeepSeek-V4.1-Flash-1017）
WENDO_LLM_MODEL_LITE=deepseek-flash

# 可选
# WENDO_LLM_CONTEXT_WINDOW=1048576
# WENDO_LLM_MAX_TOKENS=32768
# WENDO_LLM_TIMEOUT_MS=180000
# WENDO_PYTHON=python3
# WENDO_TYPST=typst
